# このファイルを .env にコピーして埋める（.env は git に入りません）

# --- 必須 ---
# https://aistudio.google.com/apikey で発行
GEMINI_API_KEY=
# `npm run mics` で表示される "..." (audio) の名前をそのまま
MIC_DEVICE=
# OBS > ツール > WebSocket サーバー設定 > 接続情報を表示 のパスワード
OBS_WS_PASSWORD=

# --- 任意: YouTube チャット ---
# Google Cloud Console で YouTube Data API v3 を有効化して API キーを発行
YOUTUBE_API_KEY=
# 配信の動画 ID（https://www.youtube.com/watch?v=XXXX の XXXX）。起動後に `v <ID>` でも指定できる
YOUTUBE_VIDEO_ID=
# CHAT_POLL_MIN_MS=10000

# --- 任意: 調整用（既定値） ---
# GEMINI_MODEL=gemini-3.8-live
# PERSONA_FILE=persona.md
# VAD_SILENCE_MS=800
# OBS_WS_URL=ws://127.0.0.1:4455
# OBS_CAPTURE_SOURCE=          # 空 = 現在のプログラムシーン
# FRAME_INTERVAL_MS=2000
# FRAME_WIDTH=960
# VOICEVOX_URL=http://127.0.0.1:50021
# VOICEVOX_SPEAKER=47          # 47 = ナースロボ＿タイプＴ ノーマル。`npm run speakers` で一覧
# VOICEVOX_SPEED=1.15
# OVERLAY_PORT=8787
# COHOST_DISPLAY_NAME=ORÐA-VÁR  # 画面左下に出す相方の名前
# CHARACTER_DIR=               # 立ち絵フォルダ（default.png と smile.png）。空なら SOUND ONLY 表示
# IDLE_MIN_SEC=0               # 沈黙が続いたら相方から話しかける（秒）。0 でオフ（既定）。使うなら 25 など
# IDLE_MAX_SEC=45
# BARGE_IN=1
# GATE_MIC_WHILE_SPEAKING=0    # スピーカー運用で相方の声をマイクが拾うなら 1
# FFMPEG_PATH=ffmpeg
# LOG_DEBUG=0
